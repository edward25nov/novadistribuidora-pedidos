# Copia este archivo como .env y pon UNA clave. .env NUNCA va a Git.
#
# Proveedor del modelo: anthropic | openrouter | auto
#   auto (por defecto): usa Anthropic si ANTHROPIC_API_KEY tiene valor; si no, OpenRouter.
PROVEEDOR_LLM=auto
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Modelo (id de la API de Anthropic). Con OpenRouter se traduce solo:
#   claude-haiku-5-5 -> anthropic/claude-haiku-5.5
# También se acepta el id de OpenRouter tal cual (con "/").
MODELO_LLM=claude-haiku-5-5
MODELO_LLM_ALT=claude-sonnet-5-5
MODELO_JUEZ=claude-opus-5-5

# Límites de la llamada al modelo (la latencia se evalúa)
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1

# Carpeta con los archivos del GES (datos/, ejemplos/, politicas.md)
RUTA_DATOS=./ges
